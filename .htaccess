<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Lindungi berkas sensitif dari unduhan langsung
    <FilesMatch "^\.(env|git|lock)|composer\.(json|lock)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>

    # 2. Rute Media Foto Produk yang Diunggah
    # Mengarahkan permintaan /unggah/produk/* langsung ke folder backend/unggah/produk/*
    RewriteCond %{DOCUMENT_ROOT}/backend/unggah/$1 -f
    RewriteRule ^unggah/(.*)$ backend/unggah/$1 [L]
    RewriteRule ^unggah/(.*)$ backend/gerbang_api/index.php [QSA,L]

    # 3. Rute Endpoint API Mikroservis Backend PHP
    RewriteRule ^api/v1/(.*)$ backend/gerbang_api/index.php [QSA,L]
    RewriteRule ^api/(.*)$ backend/gerbang_api/index.php [QSA,L]

    # 4. Berkas Statis Web (Flutter JS, Assets, Gambar, Font, Icon)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. SPA (Single Page Application) Flutter Web Routing
    # Semua rute halaman lain diarahkan ke index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Kompresi Gzip untuk Kecepatan Muat Maksimal di Hosting
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

# Pencegahan Indexing Direktori
Options -Indexes
